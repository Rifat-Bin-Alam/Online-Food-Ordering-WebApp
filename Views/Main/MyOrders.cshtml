@model List<OnlineFoodOrdering.Models.Order>
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Orders - Gourmet Bites";
}

<div class="py-2">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h1 class="mb-1" style="font-size: 2.2rem;">My Orders & Tracking</h1>
            <p class="text-muted mb-0">Follow your fresh kitchen preparation and delivery progress in real time.</p>
        </div>
        <a asp-action="Index" class="btn-primary-custom">
            <span>🍽️</span> Order More Food
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card p-5 text-center border border-subtle bg-white rounded-3 shadow-sm my-4">
            <div style="font-size: 4rem;">📦</div>
            <h3 class="mt-3 fw-bold text-dark">No Orders Placed Yet</h3>
            <p class="text-muted mx-auto" style="max-width: 420px;">
                You haven't placed any orders with Gourmet Bites yet. Explore our freshly prepared menu and experience true artisanal dining.
            </p>
            <div class="mt-3">
                <a asp-action="Index" class="btn-primary-custom px-4 py-2">
                    <span>🍕</span> Explore Menu & Order
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                var orderTotal = order.OrderItems.Sum(oi => (oi.FoodItem != null ? oi.FoodItem.Price : 0) * oi.Quantity);
                var statusClass = order.Status.ToLower() switch
                {
                    "processing" => "processing",
                    "confirmed" => "confirmed",
                    "delivered" => "delivered",
                    _ => "processing"
                };

                <div class="col-12">
                    <div class="order-card">
                        
                        <!-- Header -->
                        <div class="order-card-header">
                            <div>
                                <span class="badge bg-light text-dark border px-2 py-1 me-2 fw-bold">
                                    Order #@order.OrderId
                                </span>
                                <span class="text-muted" style="font-size: 0.9rem;">
                                    Placed on @order.OrderDate.ToString("MMMM dd, yyyy • hh:mm tt")
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <span class="status-pill @statusClass">
                                    @if (statusClass == "delivered")
                                    {
                                        <span>✓</span>
                                    }
                                    else if (statusClass == "confirmed")
                                    {
                                        <span>🍳</span>
                                    }
                                    else
                                    {
                                        <span>⏳</span>
                                    }
                                    @order.Status
                                </span>

                                <span class="fw-bold fs-5 text-dark">
                                    $@orderTotal.ToString("0.00")
                                </span>
                            </div>
                        </div>

                        <!-- Progress Pipeline Bar -->
                        <div class="p-3 bg-light rounded-3 mb-3 border border-light">
                            <div class="row text-center g-2">
                                <div class="col-4">
                                    <div class="fw-bold @(true ? "text-success" : "text-muted")" style="font-size: 0.88rem;">
                                        <span>✓</span> 1. Placed
                                    </div>
                                    <small class="text-muted">Order Received</small>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold @(order.Status == "Confirmed" || order.Status == "Delivered" ? "text-primary" : "text-muted")" style="font-size: 0.88rem;">
                                        @(order.Status == "Confirmed" || order.Status == "Delivered" ? "🍳" : "○") 2. Kitchen Prep
                                    </div>
                                    <small class="text-muted">Chefs preparing</small>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold @(order.Status == "Delivered" ? "text-success" : "text-muted")" style="font-size: 0.88rem;">
                                        @(order.Status == "Delivered" ? "✓" : "○") 3. Delivered
                                    </div>
                                    <small class="text-muted">Enjoy your meal!</small>
                                </div>
                            </div>
                        </div>

                        <!-- Itemized List -->
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Dish</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var oi in order.OrderItems)
                                    {
                                        var itemName = oi.FoodItem != null ? oi.FoodItem.Name : "Artisanal Dish";
                                        var itemPrice = oi.FoodItem != null ? oi.FoodItem.Price : 0;
                                        var img = oi.FoodItem?.ImagePath ?? "/images/burger.jpg";
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <img src="@img" alt="@itemName" style="width: 38px; height: 38px; border-radius: 6px; object-fit: cover;" />
                                                    <span class="fw-semibold text-dark">@itemName</span>
                                                </div>
                                            </td>
                                            <td>&times; @oi.Quantity</td>
                                            <td>$@itemPrice.ToString("0.00")</td>
                                            <td class="text-end fw-bold text-dark">
                                                $@((itemPrice * oi.Quantity).ToString("0.00"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Delivery Metadata -->
                        <div class="row g-2 pt-2 border-top border-light text-muted" style="font-size: 0.85rem;">
                            <div class="col-md-4">
                                <strong>Recipient:</strong> @order.CustomerName (@order.PhoneNumber)
                            </div>
                            <div class="col-md-5">
                                <strong>Delivery Address:</strong> @order.Address
                            </div>
                            <div class="col-md-3 text-md-end">
                                <strong>Payment:</strong> <span class="badge bg-secondary-subtle text-dark border">@order.PaymentMethod</span>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
