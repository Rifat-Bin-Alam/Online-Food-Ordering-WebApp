@model List<OnlineFoodOrdering.Models.Order>

<h2>My Orders</h2>

@if (!Model.Any())
{
    <p>You have not placed any orders yet.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Food</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Status</th>
                <th>Order Date/Time</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>
                        @foreach (var item in order.OrderItems)
                        {
                            <div>@item.FoodItem.Name</div>
                        }
                    </td>
                    <td>
                        @foreach (var item in order.OrderItems)
                        {
                            <div>@item.Quantity</div>
                        }
                    </td>
                    <td>
                        @foreach (var item in order.OrderItems)
                        {
                            <div>$@(item.FoodItem.Price* item.Quantity)</div>
                        }
                    </td>
                    <td>
                        <span class="badge @(order.Status == "Processing" ? "bg-warning" :
                                                                             order.Status == "Confirmed" ? "bg-primary" : "bg-success")">
                            @order.Status
                        </span>
                    </td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        $@order.OrderItems.Sum(i => i.FoodItem.Price * i.Quantity)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
