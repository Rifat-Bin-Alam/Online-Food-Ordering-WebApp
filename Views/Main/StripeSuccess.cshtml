@{
    Layout = "_Layout";
    ViewData["Title"] = "Payment Successful - Gourmet Bites";
}

<div class="py-5 text-center">
    <div class="card p-5 border border-subtle bg-white rounded-3 shadow-sm mx-auto" style="max-width: 540px;">
        <div style="font-size: 4rem; color: var(--accent-basil);">🎉</div>
        <h2 class="mt-3 fw-bold text-dark">Payment Confirmed!</h2>
        <p class="text-muted mt-2" style="line-height: 1.6;">
            Thank you! Your payment was verified via Stripe and your order has been received by our kitchen. Our chefs are preparing your meal right away.
        </p>

        <div class="p-3 bg-light rounded-3 my-3 text-start border border-light">
            <div class="d-flex align-items-center gap-2 text-success fw-bold mb-1">
                <span>✓</span> Verified Card Transaction
            </div>
            <small class="text-muted">An unread order notification has been sent to your account with real-time status updates.</small>
        </div>

        <div class="d-grid gap-2 mt-3">
            <a asp-action="MyOrders" class="btn-primary-custom py-3 text-center">
                <span>📋</span> View My Orders & Track Delivery
            </a>
            <a asp-action="Index" class="btn-secondary-custom py-2 text-center">
                <span>🍽️</span> Back to Menu
            </a>
        </div>
    </div>
</div>
