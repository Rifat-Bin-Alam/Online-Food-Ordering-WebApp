@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In - Gourmet Bites";
}

<div class="row justify-content-center align-items-center py-4 my-2">
    <div class="col-lg-10">
        <div class="card border border-subtle rounded-3 shadow-md overflow-hidden bg-white">
            <div class="row g-0">

                <!-- Left Visual Banner -->
                <div class="col-md-5 d-none d-md-block position-relative" style="background: url('/images/pasta.jpg') center/cover no-repeat; min-height: 480px;">
                    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(35, 27, 24, 0.4) 0%, rgba(35, 27, 24, 0.85) 100%);"></div>
                    <div class="position-absolute bottom-0 start-0 p-4 text-white">
                        <span class="badge bg-danger mb-2 px-3 py-1 fw-bold">Fresh Daily</span>
                        <h3 class="fw-bold text-white mb-1">Authentic Culinary Craft</h3>
                        <p class="text-white-50 mb-0" style="font-size: 0.9rem;">
                            "Food made with passion and delivered fresh with care."
                        </p>
                    </div>
                </div>

                <!-- Right Form Area -->
                <div class="col-md-7 p-4 p-lg-5 d-flex flex-column justify-content-center">
                    <div>
                        <span class="text-uppercase fw-bold text-danger" style="font-size: 0.8rem; letter-spacing: 0.08em;">
                            Account Portal
                        </span>
                        <h2 class="fw-bold text-dark mt-1 mb-2">Welcome Back</h2>
                        <p class="text-muted mb-4" style="font-size: 0.95rem;">
                            Sign in to track orders, manage your preferences, and checkout quickly.
                        </p>

                        <form asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="email" class="form-label fw-semibold text-dark">Email Address</label>
                                <input type="email" name="email" id="email" class="form-control py-2" placeholder="name@example.com" required autocomplete="email" />
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label fw-semibold text-dark">Password</label>
                                <input type="password" name="password" id="password" class="form-control py-2" placeholder="Enter your password" required autocomplete="current-password" />
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn-primary-custom py-3 text-center fs-6">
                                    <span>🔐</span> Sign In to Account
                                </button>
                            </div>
                        </form>

                        <!-- Demo Login Credentials Section -->
                        <div class="demo-credentials-section mt-4 pt-3 border-top border-light">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-1">
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1" style="font-family: var(--font-serif); font-size: 1rem;">
                                    <span>🔑</span> Demo Login Credentials
                                </h6>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size: 0.7rem; font-weight: 600;">
                                    Demo accounts — testing purposes only
                                </span>
                            </div>
                            <p class="text-muted mb-3" style="font-size: 0.82rem;">
                                Use the credentials below to test customer or administrator features. Click 📋 to copy or <strong>Fill</strong> to populate fields.
                            </p>

                            <div class="row g-2">
                                <!-- Customer Account Card -->
                                <div class="col-sm-6">
                                    <div class="demo-cred-card p-3 rounded-3 border border-subtle h-100" style="background: var(--bg-canvas);">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="fw-bold text-dark d-flex align-items-center gap-1" style="font-size: 0.86rem;">
                                                <span>👤</span> Customer Account
                                            </span>
                                            <button type="button" class="btn-fill-mini" onclick="fillLoginForm('test@gmail.com', '1234')" title="Fill into login form">
                                                Fill ⤶
                                            </button>
                                        </div>
                                        <div class="cred-row d-flex align-items-center justify-content-between py-1 border-bottom border-light">
                                            <span class="text-muted" style="font-size: 0.78rem;">Email:</span>
                                            <div class="d-flex align-items-center gap-1">
                                                <code class="text-dark fw-semibold" style="font-size: 0.8rem;">test@gmail.com</code>
                                                <button type="button" class="btn-copy-mini" onclick="copyCredValue('test@gmail.com', this)" title="Copy Email" aria-label="Copy customer email">📋</button>
                                            </div>
                                        </div>
                                        <div class="cred-row d-flex align-items-center justify-content-between pt-1">
                                            <span class="text-muted" style="font-size: 0.78rem;">Password:</span>
                                            <div class="d-flex align-items-center gap-1">
                                                <code class="text-dark fw-semibold" style="font-size: 0.8rem;">1234</code>
                                                <button type="button" class="btn-copy-mini" onclick="copyCredValue('1234', this)" title="Copy Password" aria-label="Copy customer password">📋</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Administrator Account Card -->
                                <div class="col-sm-6">
                                    <div class="demo-cred-card p-3 rounded-3 border border-subtle h-100" style="background: var(--bg-canvas);">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="fw-bold text-dark d-flex align-items-center gap-1" style="font-size: 0.86rem;">
                                                <span>🛡️</span> Administrator Account
                                            </span>
                                            <button type="button" class="btn-fill-mini" onclick="fillLoginForm('rifat@gmail.com', '11223344')" title="Fill into login form">
                                                Fill ⤶
                                            </button>
                                        </div>
                                        <div class="cred-row d-flex align-items-center justify-content-between py-1 border-bottom border-light">
                                            <span class="text-muted" style="font-size: 0.78rem;">Email:</span>
                                            <div class="d-flex align-items-center gap-1">
                                                <code class="text-dark fw-semibold" style="font-size: 0.8rem;">rifat@gmail.com</code>
                                                <button type="button" class="btn-copy-mini" onclick="copyCredValue('rifat@gmail.com', this)" title="Copy Email" aria-label="Copy admin email">📋</button>
                                            </div>
                                        </div>
                                        <div class="cred-row d-flex align-items-center justify-content-between pt-1">
                                            <span class="text-muted" style="font-size: 0.78rem;">Password:</span>
                                            <div class="d-flex align-items-center gap-1">
                                                <code class="text-dark fw-semibold" style="font-size: 0.8rem;">11223344</code>
                                                <button type="button" class="btn-copy-mini" onclick="copyCredValue('11223344', this)" title="Copy Password" aria-label="Copy admin password">📋</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4 pt-2 border-top border-light">
                            <span class="text-muted" style="font-size: 0.92rem;">Don't have an account yet?</span>
                            <a asp-action="Register" class="fw-bold text-danger text-decoration-none ms-1">Create an account</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyCredValue(val, btn) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(val).then(() => {
                    handleCopyFeedback(btn, val);
                }).catch(() => {
                    fallbackCopy(val, btn);
                });
            } else {
                fallbackCopy(val, btn);
            }
        }

        function fallbackCopy(val, btn) {
            const input = document.createElement('input');
            input.value = val;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            handleCopyFeedback(btn, val);
        }

        function handleCopyFeedback(btn, val) {
            const original = btn.textContent;
            btn.textContent = '✓';
            if (typeof showToast === 'function') {
                showToast(`Copied "${val}" to clipboard!`, 'info');
            }
            setTimeout(() => { btn.textContent = original; }, 1500);
        }

        function fillLoginForm(email, password) {
            const emailField = document.getElementById('email');
            const passwordField = document.getElementById('password');
            if (emailField && passwordField) {
                emailField.value = email;
                passwordField.value = password;
                passwordField.focus();
                if (typeof showToast === 'function') {
                    showToast('Credentials populated in form. Click Sign In to proceed.', 'info');
                }
            }
        }
    </script>
}
