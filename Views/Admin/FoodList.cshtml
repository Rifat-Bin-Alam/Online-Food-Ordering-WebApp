@model List<OnlineFoodOrdering.Models.FoodItem>

<h2>All Food Items</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<a asp-action="AddFood" class="btn btn-success mb-3">Add New Food Item</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImagePath" alt="@item.Name" style="height:80px; object-fit:cover;" />
                </td>
                <td>@item.Name</td>
                <td>$@item.Price</td>
                <td>
                    <a asp-action="EditFood" asp-route-id="@item.FoodItemId" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="DeleteFood" asp-route-id="@item.FoodItemId" class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this item?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
