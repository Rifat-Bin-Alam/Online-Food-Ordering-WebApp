@model List<OnlineFoodOrdering.Models.FoodItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Menu Catalog - Admin";
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="text-muted text-decoration-none" style="font-size: 0.9rem;">← Back to Dashboard</a>
            </div>
            <h1 class="mb-0 mt-1" style="font-size: 2.2rem;">Menu & Food Catalog</h1>
        </div>
        <a asp-action="AddFood" class="btn-primary-custom">
            <span>➕</span> Add New Food Item
        </a>
    </div>

    <!-- Table Card -->
    <div class="card border border-subtle rounded-3 shadow-sm bg-white overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom border-subtle d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">Live Menu Dishes (@Model.Count Total)</span>
            <small class="text-muted">Changes reflect immediately on customer menu</small>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Photo</th>
                        <th>Dish Name</th>
                        <th>Price</th>
                        <th class="text-end" style="min-width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            var img = !string.IsNullOrEmpty(item.ImagePath) ? item.ImagePath : "/images/burger.jpg";
                            <tr>
                                <td>
                                    <img src="@img" alt="@item.Name" style="width: 68px; height: 54px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-subtle);" />
                                </td>
                                <td>
                                    <h6 class="mb-0 fw-bold text-dark">@item.Name</h6>
                                    <small class="text-muted">Item ID: #@item.FoodItemId</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border fs-6 fw-bold">
                                        $@item.Price.ToString("0.00")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="EditFood" asp-route-id="@item.FoodItemId" class="btn btn-sm btn-outline-secondary">
                                            <span>✏️</span> Edit
                                        </a>

                                        <form asp-action="DeleteFood" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete \'@item.Name\'?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.FoodItemId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <span>🗑️</span> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                No dishes in the catalog. Click "+ Add New Food Item" above to add your first menu item.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
