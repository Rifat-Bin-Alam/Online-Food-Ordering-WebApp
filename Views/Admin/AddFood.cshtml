@model OnlineFoodOrdering.Models.FoodItem
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add Food Item - Admin";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="FoodList" class="text-muted text-decoration-none" style="font-size: 0.9rem;">← Back to Food Catalog</a>
        </div>

        <div class="card border border-subtle rounded-3 shadow-sm bg-white overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom border-subtle">
                <h3 class="mb-0 fw-bold text-dark fs-4">Add New Culinary Dish</h3>
                <small class="text-muted">Introduce a delicious new dish to the customer menu</small>
            </div>

            <div class="card-body p-4">
                <form asp-action="AddFood" method="post" enctype="multipart/form-data" id="addFoodForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-warning border border-warning-subtle mb-3 p-3 rounded-3" style="font-size: 0.9rem;"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold text-dark">Dish Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control py-2" placeholder="e.g. Smoky BBQ Bacon Cheeseburger" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-semibold text-dark">Price (USD) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control py-2" placeholder="12.99" required />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark">Food Photography Image</label>
                        <input type="file" name="image" id="imageInput" class="form-control" accept="image/*" />
                        <small class="text-muted">Upload an appetizing photo (JPEG, PNG). If omitted, a gourmet placeholder will be assigned.</small>

                        <!-- Live Image Preview -->
                        <div id="imagePreviewContainer" class="mt-3 text-center p-3 bg-light rounded-3 border border-subtle" style="display: none;">
                            <p class="text-muted small mb-2">Live Image Preview:</p>
                            <img id="imagePreview" src="#" alt="Preview" style="max-height: 180px; border-radius: 8px; object-fit: cover;" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <!-- Disabled Publish Button in Demo Mode -->
                        <button type="button" class="btn-primary-custom btn-disabled-demo py-3 text-center fs-6" disabled aria-disabled="true" title="Publishing is disabled in Demo Mode">
                            <span>🔒</span> Publish Dish to Menu
                        </button>

                        <!-- Demo Mode Explanation Note -->
                        <div class="demo-mode-alert p-3 rounded-3 d-flex align-items-start gap-2 border">
                            <span class="fs-5 flex-shrink-0" aria-hidden="true">⚠️</span>
                            <div style="font-size: 0.88rem; line-height: 1.45;">
                                <strong>Demo Mode:</strong> Publishing new food items is disabled to prevent unauthorized changes to the demonstration database.
                            </div>
                        </div>

                        <!-- Functional Cancel Action -->
                        <a asp-action="FoodList" class="btn-secondary-custom py-2 text-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imageInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const preview = document.getElementById('imagePreview');
                    preview.src = event.target.result;
                    document.getElementById('imagePreviewContainer').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
