@model OnlineFoodOrdering.Models.FoodItem
@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Food Item - Admin";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="FoodList" class="text-muted text-decoration-none" style="font-size: 0.9rem;">← Back to Food Catalog</a>
        </div>

        <div class="card border border-subtle rounded-3 shadow-sm bg-white overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom border-subtle">
                <h3 class="mb-0 fw-bold text-dark fs-4">Edit Food Item</h3>
                <small class="text-muted">Update dish title, price, or replace food photography</small>
            </div>

            <div class="card-body p-4">
                <form asp-action="EditFood" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FoodItemId" />
                    <input type="hidden" asp-for="ImagePath" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold text-dark">Dish Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control py-2" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-semibold text-dark">Price (USD) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control py-2" required />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark">Food Photography Image</label>
                        
                        <!-- Current image thumbnail -->
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mb-2 d-flex align-items-center gap-3 p-2 bg-light rounded-3 border border-subtle">
                                <img src="@Model.ImagePath" alt="@Model.Name" style="width: 70px; height: 55px; border-radius: 6px; object-fit: cover;" />
                                <div>
                                    <small class="fw-bold d-block text-dark">Current Image</small>
                                    <small class="text-muted">Choose a new file below if you want to replace it.</small>
                                </div>
                            </div>
                        }

                        <input type="file" name="image" id="editImageInput" class="form-control" accept="image/*" />

                        <!-- Live preview for new image -->
                        <div id="newImagePreviewContainer" class="mt-3 text-center p-3 bg-light rounded-3 border border-subtle" style="display: none;">
                            <p class="text-muted small mb-2">New Image Replacement Preview:</p>
                            <img id="newImagePreview" src="#" alt="New Preview" style="max-height: 180px; border-radius: 8px; object-fit: cover;" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn-primary-custom py-3 text-center fs-6">
                            <span>💾</span> Save Changes
                        </button>
                        <a asp-action="FoodList" class="btn-secondary-custom py-2 text-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editImageInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const preview = document.getElementById('newImagePreview');
                    preview.src = event.target.result;
                    document.getElementById('newImagePreviewContainer').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
