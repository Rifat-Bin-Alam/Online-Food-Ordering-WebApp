## ==============================================================================
## Visual Studio & ASP.NET Core .gitignore
## Project: Gourmet Bites — Online Food Ordering WebApp
## Target: .NET 10.0 / EF Core / SQLite / Stripe
## ==============================================================================

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio temporary files & caches
.vs/
.vscode/
.idea/
*.workspace
*.ipch

# Build results and binaries
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esults/
out/
apphost.exe
OnlineFoodOrdering.exe

# SQLite local databases and write-ahead log files
# The database and seed data are automatically generated on first run by DbInitializer
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Sensitive configuration & local environment settings
appsettings.Production.json
appsettings.Local.json
appsettings.*.local.json
appsettings.local.json
*.backup.json
*.bak
*.secrets.json
secrets.json
.secrets/
.env
.env.*

# Temporary test and scratch files
build-errors.txt
scratch*
test_*.py
verify_*.py

# Windows OS generated files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Node / NPM / Scaffolding artifacts (if any)
node_modules/
npm-debug.log*

# Crash reports and memory dumps
*.dmp
*.dump
*.crash

# Dotnet publishing and package caches
*.nupkg
*.snupkg
*.publishsettings
publish/
